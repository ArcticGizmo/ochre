<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <!-- Code copied from Perch keeps its internal visibility, so the two can be compared when fixes land on either side. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ochre" />
    <InternalsVisibleTo Include="Ochre.Tests" />
  </ItemGroup>
  <!-- In-process modules are first-party code built with Ochre (ADR 0012), so the module contracts and Core's
       helpers stay internal to Ochre's own assemblies; third-party plugins will run out of process (M7). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Ochre.Modules.Terminals" />
    <InternalsVisibleTo Include="Ochre.Modules.ShutdownPark" />
    <InternalsVisibleTo Include="Ochre.Modules.Git" />
    <InternalsVisibleTo Include="Ochre.Modules.Sprig" />
    <InternalsVisibleTo Include="Ochre.BridgeGen" />
  </ItemGroup>
</Project>
