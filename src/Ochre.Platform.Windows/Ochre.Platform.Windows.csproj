<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Windows 10 2004 SDK projection brings the WinRT notification APIs (ADR 0013, notifications spike). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\Ochre.Core\Ochre.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Rendered from ochre.svg by tools/gen-icons.cmd; regenerate rather than edit. -->
    <EmbeddedResource Include="Assets\ochre.ico" LogicalName="Ochre.Assets.ochre.ico" />
    <EmbeddedResource Include="Assets\ochre-256.png" LogicalName="Ochre.Assets.ochre-256.png" />
  </ItemGroup>
</Project>
